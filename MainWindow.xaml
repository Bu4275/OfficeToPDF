<Window x:Class="OfficeToPDF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OfficeToPDF" Height="700" Width="860" MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        Closing="Window_Closing">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <!-- 0: 標題 -->
            <RowDefinition Height="Auto"/>
            <!-- 1: 拖曳區 -->
            <RowDefinition Height="Auto"/>
            <!-- 2: 路徑區 -->
            <RowDefinition Height="Auto"/>
            <!-- 3: 格式篩選 -->
            <RowDefinition Height="Auto"/>
            <!-- 4: 執行按鈕 -->
            <RowDefinition Height="Auto"/>
            <!-- 5: 進度列 -->
            <RowDefinition Height="Auto"/>
            <!-- 6: 日誌 -->
            <RowDefinition Height="*"/>
            <!-- 7: 底部狀態 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ 標題列 ═══ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="OfficeToPDF" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="doc / docx / xls / xlsx / pptx  &#x2192;  PDF" FontSize="13"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,3,0,0"/>
            </StackPanel>

            <!-- 執行緒數量 -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="執行緒" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ThreadCombo" Width="55" Height="28" SelectedIndex="3"
                          Style="{StaticResource DarkComboBox}">
                    <ComboBoxItem Content="1" Style="{StaticResource DarkComboBoxItem}"/>
                    <ComboBoxItem Content="2" Style="{StaticResource DarkComboBoxItem}"/>
                    <ComboBoxItem Content="3" Style="{StaticResource DarkComboBoxItem}"/>
                    <ComboBoxItem Content="4" Style="{StaticResource DarkComboBoxItem}"/>
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <!-- ═══ 拖曳區域 ═══ -->
        <Border x:Name="DropBorder" Grid.Row="1" CornerRadius="14" Height="120"
                Background="{StaticResource DropBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                Margin="0,0,0,16" Cursor="Hand"
                MouseLeftButtonUp="DropArea_Click">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="DropIcon" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DropText" Text="將資料夾拖曳到此處，或點擊選擇" FontSize="14"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock Text="支援 doc / docx / xls / xlsx / pptx 批次轉換為 PDF" FontSize="11"
                           Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══ 路徑設定 ═══ -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <!-- 輸入路徑 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="輸入路徑" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <TextBox x:Name="InputPathBox" Grid.Column="1" Style="{StaticResource RoundedTextBox}"
                         Margin="0,0,8,0" TextChanged="InputPathBox_TextChanged"/>
                <Button Grid.Column="2" Content="瀏覽" Style="{StaticResource RoundedButton}"
                        Width="72" Click="BrowseInput_Click" x:Name="BrowseButton"/>
            </Grid>

            <!-- 輸出路徑 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="輸出路徑" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <TextBox x:Name="OutputPathBox" Grid.Column="1" Style="{StaticResource ReadOnlyTextBox}"/>
                <TextBlock Grid.Column="2" Text="(自動產生)" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- ═══ 格式篩選 ═══ -->
        <Border Grid.Row="3" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                Padding="14,10" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock Text="轉換格式" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                           DockPanel.Dock="Left" Margin="0,0,16,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkDoc" Content=".doc" IsChecked="True"
                              Style="{StaticResource DarkCheckBox}" Margin="0,0,18,0"/>
                    <CheckBox x:Name="ChkDocx" Content=".docx" IsChecked="True"
                              Style="{StaticResource DarkCheckBox}" Margin="0,0,18,0"/>
                    <CheckBox x:Name="ChkXls" Content=".xls" IsChecked="True"
                              Style="{StaticResource DarkCheckBox}" Margin="0,0,18,0"/>
                    <CheckBox x:Name="ChkXlsx" Content=".xlsx" IsChecked="True"
                              Style="{StaticResource DarkCheckBox}" Margin="0,0,18,0"/>
                    <CheckBox x:Name="ChkPptx" Content=".pptx" IsChecked="True"
                              Style="{StaticResource DarkCheckBox}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ 執行按鈕 ═══ -->
        <Button x:Name="ExecuteBtn" Grid.Row="4" Content="&#x25B6;  開始轉換"
                Style="{StaticResource ExecuteButton}" Margin="0,0,0,16"
                Click="Execute_Click"/>

        <!-- ═══ 進度區 ═══ -->
        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock x:Name="StatusText" Text="就緒" FontSize="12"
                           Foreground="{StaticResource TextBrush}" DockPanel.Dock="Left"/>
                <TextBlock x:Name="ErrorText" Text="" FontSize="12"
                           Foreground="{StaticResource DangerBrush}" DockPanel.Dock="Right"
                           HorizontalAlignment="Right"/>
            </DockPanel>

            <Border Grid.Row="1" CornerRadius="4" Background="#15151F" Height="8">
                <Border x:Name="ProgressFill" CornerRadius="4" Background="{StaticResource PrimaryBrush}"
                        HorizontalAlignment="Left" Width="0"/>
            </Border>
        </Grid>

        <!-- ═══ 日誌區 ═══ -->
        <Border Grid.Row="6" CornerRadius="12" Background="#13132A" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" Margin="0,0,0,10" Padding="2">
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                     Background="Transparent" Foreground="#B0B0CC" BorderThickness="0"
                     FontFamily="Cascadia Code,Consolas,Courier New" FontSize="11.5"
                     Padding="12,10" CaretBrush="Transparent"/>
        </Border>

        <!-- ═══ 底部狀態 ═══ -->
        <DockPanel Grid.Row="7">
            <TextBlock x:Name="TimeText" Text="" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Left"/>
            <TextBlock x:Name="FileCountText" Text="" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Right"
                       HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
